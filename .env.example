# ============================================
# PLATFORM SELECTION
# ============================================
PLATFORM=github  # Options: azure_devops, gitlab, github

# ============================================
# AZURE DEVOPS CONFIGURATION
# ============================================
AZURE_DEVOPS_PAT=your_pat_token
AZURE_DEVOPS_ORGANIZATION=your_org
AZURE_DEVOPS_PROJECT=your_project
AZURE_DEVOPS_REPOSITORY_ID=your_repo_id

# ============================================
# GITLAB CONFIGURATION
# ============================================
GITLAB_TOKEN=your_gitlab_token
GITLAB_URL=https://gitlab.com
GITLAB_PROJECT_ID=12345678

# ============================================
# GITHUB CONFIGURATION
# ============================================
GITHUB_TOKEN=your_github_token
GITHUB_REPOSITORY=owner/repo
# Optional: GitHub App authentication
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=

# ============================================
# LLM PROVIDER CONFIGURATION
# ============================================
LLM_PROVIDER=anthropic  # Options: azure_ai, anthropic

# Azure AI Configuration
AZURE_AI_API_KEY=your_azure_api_key
AZURE_AI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_AI_DEPLOYMENT_NAME=gpt-4
AZURE_AI_API_VERSION=2024-02-15-preview

# Anthropic Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929  # or claude-opus-4-1-20250514

# ============================================
# AGENT CONFIGURATION
# ============================================
# Review Agent Settings
REVIEW_ENABLED=true
REVIEW_DEPTH=standard  # Options: quick, standard, deep
REVIEW_FOCUS=all  # Options: all, security, performance, style, bugs
MAX_FILES_TO_REVIEW=50
EXCLUDE_PATTERNS=*.md,*.txt,package-lock.json,*.min.js
INCLUDE_LINE_COMMENTS=true
INCLUDE_FILE_COMMENTS=true
INCLUDE_PR_SUMMARY=true
SEVERITY_THRESHOLD=minor  # Options: critical, major, minor, suggestion

# Fix Agent Settings
FIX_ENABLED=true
FIX_AUTO_CREATE_PR=true
FIX_BRANCH_PREFIX=fix/ai-review-
FIX_SEVERITY_FILTER=major  # Only fix issues >= this severity
FIX_MAX_FILES=20
FIX_VALIDATE_SYNTAX=true
FIX_RUN_TESTS=false

# ============================================
# GENERAL SETTINGS
# ============================================
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR
MAX_RETRIES=3
TIMEOUT_SECONDS=300
ENABLE_WEBHOOKS=true
WEBHOOK_SECRET=your_webhook_secret

# ============================================
# COMMENT TEMPLATES
# ============================================
REVIEW_COMMENT_PREFIX=[AI Review]
FIX_PR_TITLE_PREFIX=[AI Fix]
FIX_PR_DESCRIPTION_TEMPLATE=templates/pr_descriptions/fix_pr_template.md
